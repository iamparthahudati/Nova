# Copy this file to .env and fill in your key. Never commit .env.
# (NOVA_* names preferred; legacy RAI_* names are still accepted.)
NOVA_CLAUDE_API_KEY=sk-ant-...

# Optional — override the model (defaults to claude-haiku-4-5-20251001)
# NOVA_MODEL=claude-haiku-4-5-20251001

# Optional — assistant identity (defaults shown; see apps/backend/identity.py)
# ASSISTANT_NAME=Nova
# WAKE_WORD=nova
# WAKE_WORD_ALIASES=hey nova,inova

# Optional — knowledge-graph entity extraction (defaults shown; see apps/backend/services/brain/config.py)
# NOVA_ENTITY_EXTRACTION=true
# NOVA_EXTRACTION_BATCH_SIZE=10
# NOVA_EXTRACTION_MAX_ATTEMPTS=3
# NOVA_EXTRACTION_MAX_BATCHES=5

# Optional — Context Engine (Milestone 2.8; defaults shown; see apps/backend/services/brain/config.py)
# NOVA_CONTEXT_TOKEN_BUDGET=2000     # global prompt-context ceiling; 0 disables
# NOVA_GRAPH_CONTEXT=true            # knowledge-graph section in the prompt
# NOVA_GRAPH_MAX_ENTITIES=3
# NOVA_GRAPH_MAX_EDGES=4
# NOVA_GRAPH_TOKEN_BUDGET=250
# NOVA_CALENDAR_CONTEXT=true         # calendar section (active only in the assistant process)
# NOVA_CALENDAR_CONTEXT_TTL=300      # seconds one AppleScript fetch is reused
# NOVA_CALENDAR_TOKEN_BUDGET=150
# NOVA_TASKS_TOKEN_BUDGET=400
# NOVA_ACTIVITY_TOKEN_BUDGET=450
# NOVA_PROFILE_TOKEN_BUDGET=350

# Optional — future asset and model paths (not wired by default; see apps/backend/paths.py)
# WAKE_CUE_SOUND=assets/audio/notification/cue.aiff
# PIPER_MODEL=assets/audio/voices/en_US-lessac-medium.onnx
# NOVA_DATA_DIR=data

# Optional — Nova API facade (Milestone 2.11; see apps/backend/api_server.py)
# NOVA_API_PORT=8001
# NOVA_API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional — Nova desktop renderer (apps/desktop)
# VITE_NOVA_API_URL=http://localhost:8001
# VITE_USE_MOCKS=false
