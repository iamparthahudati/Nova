[flake8]
max-line-length = 100
max-complexity = 12
exclude = .venv,data,models,__pycache__
# E203/W503 conflict with black's formatting choices (slice spacing, binary-op
# line breaks); E501 is enforced by black itself already.
extend-ignore = E203,W503,E501

# __init__.py files intentionally re-export names as the package's public API
# (Handbook §8.1 "Public API" contract) — that is a deliberate unused-import.
per-file-ignores =
    */__init__.py:F401
